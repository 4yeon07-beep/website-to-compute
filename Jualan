<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Gesz — Solusi Kreatif & Praktis</title>
<meta name="description" content="Gesz: desain cepat & terjangkau untuk UMKM, content creator, dan hadiah custom." />
<style>
  :root{
    --bg:#0f1724; --card:#0b1220; --accent:#ff6b6b; --muted:#9aa4b2; --glass: rgba(255,255,255,0.03);
    --radius:14px;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial;background:linear-gradient(180deg,var(--bg),#071021);color:#e6eef6;line-height:1.4}
  .wrap{max-width:980px;margin:28px auto;padding:20px}
  header{display:flex;align-items:center;gap:16px}
  .logo{
    display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:12px;background:var(--glass);backdrop-filter: blur(6px)
  }
  .mark{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#ff9a9e,#ff6b6b);display:flex;align-items:center;justify-content:center;font-weight:700;color:#08121a}
  h1{margin:0;font-size:28px}
  p.lead{color:var(--muted);margin-top:6px}
  .hero{display:grid;grid-template-columns:1fr 360px;gap:18px;margin-top:22px}
  .card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));padding:18px;border-radius:var(--radius);box-shadow: 0 6px 18px rgba(2,6,23,0.6)}
  .cta{display:flex;gap:10px;align-items:center;margin-top:14px}
  .btn{background:var(--accent);border:none;padding:12px 16px;border-radius:10px;color:#08121a;font-weight:700;cursor:pointer}
  .ghost{background:transparent;border:1px solid rgba(255,255,255,0.06);padding:10px 14px;border-radius:10px;color:var(--muted);cursor:pointer}
  ul.features{padding:0;margin:12px 0 0 0;list-style:none;display:grid;gap:10px}
  li.feature{display:flex;gap:12px;align-items:flex-start}
  .dot{width:44px;height:44px;border-radius:10px;background:rgba(255,255,255,0.03);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent)}
  .prices{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
  .price{flex:1;min-width:140px;padding:12px;border-radius:10px;background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00));border:1px solid rgba(255,255,255,0.03)}
  form{display:flex;flex-direction:column;gap:10px}
  input,textarea,select{background:transparent;border:1px solid rgba(255,255,255,0.06);padding:10px;border-radius:8px;color:inherit}
  textarea{min-height:90px;resize:vertical}
  footer{margin-top:26px;color:var(--muted);font-size:13px;text-align:center}
  @media(max-width:880px){.hero{grid-template-columns:1fr;}.wrap{padding:14px}}
</style>
</head>
<body>
  <div class="wrap">
    <header>
      <div class="logo">
        <div class="mark">GZ</div>
        <div>
          <div style="font-weight:700">Gesz</div>
          <div style="font-size:12px;color:var(--muted)">Solusi Kreatif & Praktis</div>
        </div>
      </div>
      <div style="margin-left:auto;color:var(--muted);font-size:13px">Cepat • Terjangkau • Siap Pakai</div>
    </header>

    <main class="hero" role="main">
      <section class="card">
        <h1>Buat brand-mu jadi gampang.</h1>
        <p class="lead">Desain cepat, harga ramah, hasil yang bisa langsung dipakai untuk promosi atau cetak. Pilih paket — kita kerjakan.</p>
        <div class="cta">
          <button class="btn" onclick="scrollToEl('#order')">Pesan Sekarang</button>
          <button class="ghost" onclick="window.location='mailto:hello@gesz.example?subject=Pesanan%20Gesz'">Kontak via Email</button>
        </div>

        <ul class="features" aria-label="fitur">
          <li class="feature">
            <div class="dot">1</div>
            <div>
              <strong>Fast turnaround</strong>
              <div style="color:var(--muted);font-size:13px">Banyak order selesai 24–72 jam.</div>
            </div>
          </li>
          <li class="feature">
            <div class="dot">★</div>
            <div>
              <strong>Paket siap pakai</strong>
              <div style="color:var(--muted);font-size:13px">Template yang mudah disesuaikan.</div>
            </div>
          </li>
          <li class="feature">
            <div class="dot">❤</div>
            <div>
              <strong>Harga ramah</strong>
              <div style="color:var(--muted);font-size:13px">Cocok buat pemula dan UMKM.</div>
            </div>
          </li>
        </ul>

        <div class="prices" aria-hidden="false">
          <div class="price"><strong>Starter Kit</strong><div style="font-size:13px;color:var(--muted)">Logo + palet + mockup</div><div style="margin-top:8px;font-weight:700">Rp 150.000</div></div>
          <div class="price"><strong>Social Pack</strong><div style="font-size:13px;color:var(--muted)">5 post template</div><div style="margin-top:8px;font-weight:700">Rp 120.000</div></div>
          <div class="price"><strong>One-off</strong><div style="font-size:13px;color:var(--muted)">Poster / flyer</div><div style="margin-top:8px;font-weight:700">Mulai Rp 50.000</div></div>
        </div>
      </section>

      <aside class="card" id="order" aria-labelledby="order-title">
        <h3 id="order-title">Form Pesanan Cepat</h3>
        <form onsubmit="handleSubmit(event)">
          <label>
            Nama / Brand
            <input type="text" id="name" placeholder="Nama kamu atau brand" required />
          </label>
          <label>
            Pilih Paket
            <select id="paket">
              <option>Starter Kit — Rp 150.000</option>
              <option>Social Pack — Rp 120.000</option>
              <option>One-off Design — mulai Rp 50.000</option>
              <option>Paket Langganan — Rp 350.000 / bulan</option>
            </select>
          </label>
          <label>
            Keterangan singkat
            <textarea id="note" placeholder="Contoh: warna favorit, teks yang mau dimasukkan, deadline"></textarea>
          </label>
          <label>
            Kontak (WA / Email)
            <input type="text" id="contact" placeholder="08xx atau email@contoh.com" required />
          </label>
          <button class="btn" type="submit">Kirim Pesanan</button>
        </form>

        <hr style="margin:14px 0;border:none;border-top:1px solid rgba(255,255,255,0.04)" />
        <div style="font-size:13px;color:var(--muted)">
          Catatan: Form ini demo — jika ingin terhubung langsung, klik <a style="color:var(--accent);text-decoration:none" href="mailto:hello@gesz.example">email</a> atau hubungi via WhatsApp.
        </div>
      </aside>
    </main>

    <footer>
      © <span id="year"></span> Gesz — Made with care. • Follow: @gesz_official
    </footer>
  </div>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();
  function scrollToEl(sel){ document.querySelector(sel).scrollIntoView({behavior:'smooth'}) }

  function handleSubmit(e){
    e.preventDefault();
    const name = document.getElementById('name').value.trim();
    const paket = document.getElementById('paket').value;
    const note = document.getElementById('note').value.trim();
    const contact = document.getElementById('contact').value.trim();
    // buat pesan mailto sebagai fallback (karena ini static demo)
    const subject = encodeURIComponent('Pesanan Gesz: ' + paket + ' — ' + name);
    const body = encodeURIComponent('Nama/Brand: ' + name + '\\nPaket: ' + paket + '\\nKeterangan: ' + note + '\\nKontak: ' + contact);
    window.location.href = 'mailto:hello@gesz.example?subject=' + subject + '&body=' + body;
  }
</script>
</body>
</html>
